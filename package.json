{
  "name": "tempoquiz",
  "version": "1.0.0",
  "private": true,
  "description": "TempoQuiz \u2014 live classroom quiz app for WING-NUS",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite --no-warnings server/index.js",
